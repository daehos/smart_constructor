          }
        },
        {
          "name": "Send message (immediate)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"6281234567890\",\n  \"body\": \"Halo dari Smart Constructor (Postman).\"\n}"
            },
            "url": "{{baseUrl}}/whatsapp/send",
            "description": "Queues `send-whatsapp-immediate` on the scheduled-whatsapp queue (high priority). **202** when accepted — delivery is async; the WhatsApp worker must be connected. Same validation as schedules for `to` / `body` length."
