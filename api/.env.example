# Copy to .env and adjust values.
# cp .env.example .env

# --- App ---
NODE_ENV=development
PORT=8080
API_VERSION=v1
# Host port when API runs in Docker (`make docker-dev-api-up`). Container listens on 8080.
# DEV_HOST_PORT=8080

# --- MongoDB (docker-compose.dev / prod: root user + auth) ---
# Used by the Mongo container on first init. Match MONGO_ROOT_* in MONGODB_URI for Compass / host API.
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=mongo_dev_secret_change_me
# Local API / Compass / seeders (localhost). authSource=admin is required for the root user.
MONGODB_URI=mongodb://mongo_admin:mongo_dev_secret_change_me@127.0.0.1:27017/smart_constructor?authSource=admin

# --- Redis (ioredis; Redis 6+ default user is "default") ---
# With docker-compose.dev, password matches the redis service (see README).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=dev_redis_secret

# --- Auth ---
# Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_secret_in_production

# --- Email (OTP via Gmail; optional in dev if you do not hit send-otp) ---
EMAIL_USER=
EMAIL_PASSWORD=

# --- MinIO (local object storage for receipt images) ---
# With docker-compose, endpoint is the service name (minio).
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_dev_user
MINIO_SECRET_KEY=minio_dev_secret
MINIO_BUCKET_RECEIPTS=receipts
MINIO_USE_SSL=false

# --- OCR (Gemini API) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Receipt upload limits ---
# Max upload size in bytes. Default is 5 MB (5242880).
RECEIPT_MAX_UPLOAD_BYTES=5242880

# --- WhatsApp (Baileys session-based, unofficial API) ---
# Directory where Baileys persists session credentials (multi-file auth state).
# Must be a persistent volume when running in Docker.
WHATSAPP_AUTH_DIR=./wa-auth
# IANA timezone used when no timezone is provided in a schedule request.
WHATSAPP_DEFAULT_TZ=Asia/Jakarta
# Max random jitter (ms) added before each send to reduce ban risk.
WHATSAPP_SEND_DELAY_MS=1500
# How long (seconds) a QR code is kept in Redis before expiring.
WHATSAPP_QR_TTL_SECONDS=60
# Optional (whatsapp worker only): override Baileys protocol version "major,build,revision" if connection fails with 405
# WHATSAPP_WA_VERSION=2,3000,1019707846

# --- Site / attendance defaults (optional) ---
SITE_NAME=Klapa Village
# Optional second line on map UI (e.g. area name from reference app).
# SITE_AREA=Pondok Kelapa
SITE_LAT=-6.2615
SITE_LNG=106.9335
SITE_RADIUS_METERS=100
# Which calendar day is "today" for clock-in/out (IANA, e.g. Asia/Jakarta).
ATTENDANCE_TIME_ZONE=Asia/Jakarta
