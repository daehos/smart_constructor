# WhatsApp worker environment variables

# MongoDB connection URI (must include auth and database name)
MONGODB_URI=mongodb://admin:changeme@localhost:27017/smart_constructor?authSource=admin

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=changeme

# Baileys session storage directory (relative to whatsapp service root)
WHATSAPP_AUTH_DIR=./wa-auth

# Default timezone for scheduled messages (IANA tz name)
WHATSAPP_DEFAULT_TZ=Asia/Jakarta

# Jitter delay between successive sends (ms)
WHATSAPP_SEND_DELAY_MS=1500

# TTL for QR code stored in Redis (seconds)
WHATSAPP_QR_TTL_SECONDS=60

# Optional: force Baileys WA Web version [major, build, revision] — use if you still get 405 / connection failure
# WHATSAPP_WA_VERSION=2,3000,1019707846
