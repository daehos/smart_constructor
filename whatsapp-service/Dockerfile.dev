# Dev WhatsApp worker — repo mounted at /app; installs deps via pnpm workspaces.
FROM node:22-bookworm-slim

WORKDIR /app/whatsapp-service

COPY whatsapp-service/scripts/docker-entrypoint.dev.sh /usr/local/bin/docker-entrypoint-whatsapp-dev.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-whatsapp-dev.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint-whatsapp-dev.sh"]
